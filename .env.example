# Supabase (projet en région UE, ex. eu-west-3 Paris)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service : uniquement côté serveur (cron d'émission des factures)
SUPABASE_SERVICE_ROLE_KEY=

# URL publique de l'application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret partagé pour l'appel du cron (Vercel Cron envoie "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=

# Campay (paiement Orange Money / MTN MoMo). Démo : https://demo.campay.net ; production : URL donnée par Campay.
CAMPAY_BASE_URL=https://demo.campay.net
# Jeton permanent de l'application (section « APP KEYS » du tableau de bord Campay)
CAMPAY_TOKEN=
# Clé de webhook de l'application Campay (vérifie la signature des notifications)
CAMPAY_WEBHOOK_KEY=

# WhatsApp (API Cloud de Meta) : voir README, « Configurer WhatsApp »
# Jeton permanent d'un utilisateur système Meta (whatsapp_business_messaging)
WHATSAPP_TOKEN=
# Identifiant du numéro d'envoi (WhatsApp → Configuration de l'API)
WHATSAPP_PHONE_NUMBER_ID=
# Clé secrète de l'application Meta (vérifie la signature du webhook)
WHATSAPP_APP_SECRET=
# Phrase de votre choix, saisie aussi dans Meta lors de l'abonnement au webhook
WHATSAPP_VERIFY_TOKEN=
# Version de l'API Graph (facultatif)
# WHATSAPP_API_VERSION=v23.0
